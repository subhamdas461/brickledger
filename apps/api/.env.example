# Copy to apps/api/.env for local overrides. Every value has a safe development default.

# --- server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Set to true behind a load balancer / reverse proxy (correct client IPs for rate limiting).
TRUST_PROXY=false

# Public URL of the web app (used in emails, invite links and payment redirects).
APP_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- database -------------------------------------------------------------
# PostgreSQL in production. Leave empty to use the embedded PGlite database in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.data/pglite
DB_POOL_MAX=10
MIGRATE_ON_START=true

# --- auth -----------------------------------------------------------------
# REQUIRED in production: at least 32 random characters (e.g. `openssl rand -base64 48`).
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=60
AUTH_RATE_LIMIT_PER_MIN=20

# --- file storage ---------------------------------------------------------
# local | s3 | vercel-blob  (s3 works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces...)
STORAGE_DRIVER=local
# From a Vercel Blob store created as Private. On Vercel, setting this alone turns Blob storage on.
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- email ----------------------------------------------------------------
# smtp(s)://user:pass@host:port - when empty, emails are printed to the log.
SMTP_URL=
MAIL_FROM=BrickLedger <no-reply@brickledger.app>

# --- admin panel ----------------------------------------------------------
# Timezone that decides when a day starts in the admin panel's stats.
STATS_TIMEZONE=Asia/Kolkata

# --- billing --------------------------------------------------------------
# mock (instant upgrades, for development/demos) | stripe | razorpay
BILLING_PROVIDER=mock
# Currency shown on the pricing page: INR or USD.
PRICING_CURRENCY=INR

# Stripe: create 4 recurring prices and a webhook endpoint pointing at
#   https://<your-domain>/api/v1/billing/webhooks/stripe
# with events: checkout.session.completed, customer.subscription.created/updated/deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=

# Razorpay: `npm run razorpay:setup` creates the 4 plans and writes these to a file ready to import.
# Then add a webhook in the Razorpay dashboard pointing at
#   https://<your-domain>/api/v1/billing/webhooks/razorpay
# with subscription.* events.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
 =
RAZORPAY_PLAN_PRO_MONTH=
RAZORPAY_PLAN_PRO_YEAR=
RAZORPAY_PLAN_BUSINESS_MONTH=
RAZORPAY_PLAN_BUSINESS_YEAR=

# --- single-container deploys ----------------------------------------------
# Serve the built web app (apps/web/dist) from the API server.
SERVE_WEB=false
WEB_DIST=../web/dist

# ------------------------------------------------------------------ Vercel only
# Set in Vercel → Settings → Environment Variables (see README "Vercel"). The Vercel build packages
# the API as a function and defaults these for you: TRUST_PROXY=true, MIGRATE_ON_START=false
# (migrations run during production builds), MAX_UPLOAD_MB=4, DB_POOL_MAX=3, APP_URL = production domain.
# MIGRATE_ON_BUILD=true      # also migrate on preview builds
# FUNCTION_REGION=bom1       # run the API near the database (bom1 = Mumbai)
# API_MAX_DURATION=30        # seconds per API request
