{
  "name": "brickledger",
  "private": true,
  "version": "1.0.0",
  "description": "BrickLedger - cost, material, labour and progress tracking for house construction (API + Web + Android).",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @brickledger/api",
    "dev:web": "npm run dev --workspace @brickledger/web",
    "build": "npm run build --workspace @brickledger/web && npm run build --workspace @brickledger/api",
    "start": "npm run start --workspace @brickledger/api",
    "test": "npm run test --workspace @brickledger/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @brickledger/api",
    "db:migrate": "npm run db:migrate --workspace @brickledger/api",
    "seed:demo": "npm run seed:demo --workspace @brickledger/api",
    "admin": "npm run admin --silent --workspace @brickledger/api --",
    "release:android": "node scripts/publish-android.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@vercel/nft": "1.11.0",
    "qrcode": "1.5.4"
  }
}
